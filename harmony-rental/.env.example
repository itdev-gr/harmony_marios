# SMTP credentials for the booking / contact inquiry emails (src/lib/notify.ts).
# Choose a provider through the Vercel Marketplace at deploy time — this code
# is provider-agnostic and works with any standard SMTP relay.
#
# Left unset, sendMail() logs the composed message instead of sending it, so
# local dev and preview deploys work without real credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Harmony Rental <bookings@harmonyrental.gr>"
